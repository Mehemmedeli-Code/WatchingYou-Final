@inject MovieRental.Host.Infrastructure.Localization.ILanguageContext T
@{
    // The layout reads the page's own strongly-typed model — no ViewData round trip.
    var view = ((AppPageModel)Model).View;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@view.Language" class="rr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@view.Title</title>
    <meta name="description" content="@view.Tagline" />
    <meta name="color-scheme" content="dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    @if (view.Assets.StyleUrl is { } styleUrl)
    {
        <link rel="stylesheet" href="@styleUrl" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
</head>
<body class="rr-body">
    <a class="rr-skip" href="#main">@T["nav.skip"]</a>

    <header class="rr-header">
        <a class="rr-wordmark" href="/" aria-label="Reel and Row home">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10.2" fill="none" stroke="currentColor" stroke-width="1.3" />
                <circle cx="12" cy="12" r="2.6" fill="currentColor" />
                <circle cx="12" cy="5.6" r="2" fill="currentColor" opacity=".75" />
                <circle cx="12" cy="18.4" r="2" fill="currentColor" opacity=".75" />
                <circle cx="5.6" cy="12" r="2" fill="currentColor" opacity=".75" />
                <circle cx="18.4" cy="12" r="2" fill="currentColor" opacity=".75" />
            </svg>
            <span>Reel &amp; Row</span>
        </a>

        @* Items the signed-in user may not see were never added to the model, so there is
           nothing here to hide, grey out or forget to guard. *@
        <nav class="rr-nav" aria-label="@(T["nav.catalogue"])">
            @foreach (var item in view.Nav)
            {
                <a href="@item.Href" class="@(item.IsCurrent ? "is-current" : null)">@item.Label</a>
            }
        </nav>

        <div class="rr-tools">
            <div class="rr-lang">
                @foreach (var option in view.Languages)
                {
                    <a href="/lang/@option.Code?returnUrl=@(Uri.EscapeDataString(returnUrl))"
                       class="@(option.IsCurrent ? "is-current" : null)"
                       hreflang="@option.Code" title="@option.Name">@option.Code.ToUpperInvariant()</a>
                }
            </div>
            <a class="rr-account" href="/account">@(view.IsSignedIn ? T["nav.account"] : T["nav.signIn"])</a>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="rr-footer">
        <p>@T["footer.note"]</p>
    </footer>

    @* Translations travel with the document so React renders in the right language on the
       first paint rather than flashing keys while a fetch completes. *@
    <script id="rr-i18n" type="application/json">@Html.Raw(view.TranslationsJson)</script>
    <script>
        window.__RR__ = {
            lang: "@view.Language",
            t: JSON.parse(document.getElementById("rr-i18n").textContent || "{}")
        };
    </script>

    @if (view.Assets.ViteClientUrl is { } viteClient)
    {
        <script type="module" src="@viteClient"></script>
    }
    @if (view.Assets.UseDevServer)
    {
        <script type="module" src="@view.Assets.ScriptUrl"></script>
    }
    else
    {
        <script type="module" src="@view.Assets.ScriptUrl" asp-append-version="true"></script>
    }
</body>
</html>
