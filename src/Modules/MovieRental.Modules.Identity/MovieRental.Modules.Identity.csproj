<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\MovieRental.SharedKernel\MovieRental.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests exercise internal helpers (card checks, code hashing). Exposing them to
         one named assembly keeps them internal to everyone else. -->
    <InternalsVisibleTo Include="MovieRental.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept in the repository, left out of the build. Its two classes, ConsoleEmailSender and
         ConsoleSmsSender, now live in NotificationSenders.cs; compiling both would declare each
         class twice (CS0101). The repository keeps every file it has ever had, so the old copy
         stays and is simply not compiled. -->
    <Compile Remove="Infrastructure\ConsoleSenders.cs" />
  </ItemGroup>

</Project>
