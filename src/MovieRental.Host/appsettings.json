{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=MovieRentalDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "MovieRental",
    "Audience": "MovieRental.Client",
    "SecretKey": "replace-this-with-a-64-character-secret-stored-in-user-secrets-please!",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "VerificationCodeMinutes": 10
  },
  "Notifications": {
    "Email": {
      "_comment": "Provider: 'Console' logs the code, 'Smtp' actually sends it. Put UserName/Password in user secrets, never here.",
      "Provider": "Console",
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "WatchingYou"
    },
    "Sms": {
      "_comment": "Provider: 'Console' or 'Twilio'. AccountSid/AuthToken belong in user secrets.",
      "Provider": "Console",
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    }
  },
  "Payments": {
    "Stripe": {
      "_comment": "Optional. With a test key (sk_test_...) in user secrets the checkout offers 'Pay with Stripe'. Empty = built-in test checkout only. Never put the key here.",
      "SecretKey": "",
      "Currency": "azn"
    }
  },
  "Rentals": {
    "LateFee": {
      "DailyRateMultiplier": 1.5,
      "GraceHours": 6,
      "MaxFeeMultiplier": 10
    }
  },
  "Legal": {
    "_comment": "Shown on /privacy. Fill in the real operator and a monitored address before publishing the app.",
    "CompanyName": "WatchingYou",
    "ContactEmail": ""
  },
  "Mobile": {
    "_comment": "Origins the phone app calls the API from: iOS (capacitor://), Android (https://localhost).",
    "AllowedOrigins": [ "capacitor://localhost", "https://localhost", "http://localhost" ]
  },
  "Frontend": {
    "DevServerUrl": "http://localhost:5173",
    "UseDevServer": false
  },
  "AiVideoStudioUrl": "https://higgsfield.ai/",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
