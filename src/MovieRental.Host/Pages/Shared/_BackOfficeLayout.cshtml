@{
    // The back office's own frame. No public header, no nav to the catalogue, no animated
    // backdrop: the React island draws a sidebar made for a till and a manager's desk.
    var view = ((AppPageModel)Model).View;
}
<!DOCTYPE html>
<html lang="@view.Language" class="rr" data-theme="dark" style="color-scheme: dark">
<head>
    <script nonce="@Context.Items["csp-nonce"]">
        (function () {
            try {
                var saved = localStorage.getItem("wy.theme");
                var theme = saved === "light" ? "light" : "dark";
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
            } catch (e) { /* storage blocked: stay dark */ }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@view.Title · WatchingYou</title>
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    @if (view.Assets.StyleUrl is { } styleUrl)
    {
        <link rel="stylesheet" href="@styleUrl" />
    }
    <style>
        html, body { margin: 0; min-height: 100%; }
        body { background: var(--color-surface, #0A0C0A); }
    </style>
</head>
@* Signed in or not, as on the rest of the site: the island exchanges the session cookie for a token
   when it has none of its own (client/src/lib/api.ts, sessionFromCookie). Without it a cashier who
   opened the back office first was shown "staff only". *@
<body class="bo-body" data-signed-in="@(view.IsSignedIn ? "true" : null)">
    @RenderBody()

    <script id="rr-i18n" type="application/json">@Html.Raw(view.TranslationsJson)</script>
    <script nonce="@Context.Items["csp-nonce"]">
        window.__RR__ = {
            lang: "@view.Language",
            t: JSON.parse(document.getElementById("rr-i18n").textContent || "{}"),
            languages: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(view.Languages.Select(l => l.Code)))
        };
    </script>

    @if (view.Assets.ViteClientUrl is { } viteClient)
    {
        <script type="module" src="@viteClient"></script>
    }
    <script type="module" src="@view.Assets.ScriptUrl"></script>
</body>
</html>
