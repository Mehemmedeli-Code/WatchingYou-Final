@page "/error/{code:int?}"
@model ErrorModel
@inject MovieRental.Host.Infrastructure.Localization.ILanguageContext T

<section class="rr-error">
    <p class="rr-error-code" aria-hidden="true">@Model.ErrorCode</p>

    @* The eye from the wordmark, half-closed. It carries the brand without needing a word. *@
    <svg class="rr-error-eye" width="88" height="62" viewBox="0 0 64 44" role="img" aria-label="@Model.Heading">
        <path d="M2 22C2 22 14 8 32 8s30 14 30 14-12 14-30 14S2 22 2 22Z"
              fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" opacity=".55" />
        <path d="M6 22C14 30 22 33 32 33s18-3 26-11" fill="none"
              stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
    </svg>

    <h1>@Model.Heading</h1>
    <p class="rr-error-body">@Model.Explanation</p>

    <div class="rr-error-actions">
        <a class="rr-error-primary" href="/">@T["error.home"]</a>
        <a class="rr-error-secondary" href="/help">@T["nav.help"]</a>
    </div>

    <p class="rr-error-trace">@Model.TraceId</p>
</section>
