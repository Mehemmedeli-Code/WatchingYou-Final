@page
@model StaffUnlockModel
@inject ILanguageContext T
@{
    Layout = null;
}
<!doctype html>
<html lang="@Model.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>@T["staff.title"] · WatchingYou</title>
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <style>
        @@view-transition { navigation: auto; }
        :root { color-scheme: dark; --bg: #040a07; --card: #0b1510; --line: #1c2e24; --ink: #eafff2; --mute: #8fa99a; --accent: #2fe07e; --bad: #ff6b6b; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; background: radial-gradient(circle at 50% 0%, #0d2b1b, var(--bg) 60%); color: var(--ink); font: 15px/1.5 Inter, system-ui, sans-serif; }
        main { width: 100%; max-width: 380px; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 32px 28px; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
        svg { color: var(--accent); }
        h1 { margin: 14px 0 6px; font: 700 22px/1.2 Poppins, Inter, sans-serif; }
        p { margin: 0 0 22px; color: var(--mute); font-size: 14px; }
        input { width: 100%; height: 56px; border-radius: 12px; border: 1px solid var(--line); background: #050c08; color: var(--ink); text-align: center; font: 600 26px/1 ui-monospace, monospace; letter-spacing: .5em; padding-left: .5em; }
        input:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: transparent; }
        button { margin-top: 14px; width: 100%; height: 48px; border: 0; border-radius: 12px; background: var(--accent); color: #03140b; font: 700 15px Inter, sans-serif; cursor: pointer; }
        button:hover { filter: brightness(1.08); }
        .problem { margin: 14px 0 0; color: var(--bad); font-size: 13px; }
        .back { display: inline-block; margin-top: 18px; color: var(--mute); font-size: 13px; text-decoration: none; }
        .back:hover { color: var(--ink); }
    </style>
</head>
<body>
    <main>
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="10.5" width="16" height="10" rx="2.5" />
            <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
            <circle cx="12" cy="15.5" r="1.4" />
        </svg>
        <h1>@T["staff.title"]</h1>
        <p>@T["staff.lede"]</p>
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input name="pin" type="password" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="12"
                   autocomplete="off" required autofocus aria-label="@T["staff.pin"]" placeholder="••••" />
            <button type="submit">@T["staff.enter"]</button>
            @if (Model.Problem is not null)
            {
                <p class="problem" role="alert">@Model.Problem</p>
            }
        </form>
        <a class="back" href="/">@T["staff.back"]</a>
    </main>
</body>
</html>
